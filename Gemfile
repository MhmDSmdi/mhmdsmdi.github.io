source 'https://rubygems.org'

group :jekyll_plugins do
    gem 'jekyll'
    gem 'jekyll-email-protect'
    gem 'jekyll-feed'
    gem 'jekyll-imagemagick'
    gem 'jekyll-link-attributes'
    gem 'jekyll-minifier'
    gem 'jekyll-scholar'
    gem 'jekyll-sitemap'
    gem 'jemoji'
    gem 'mini_racer'      # JS runtime required by jekyll-minifier
    gem 'unicode_utils'   # required by jekyll-scholar's smallcaps filter
    gem 'webrick'         # required by `jekyll serve` on Ruby >= 3.0
end
